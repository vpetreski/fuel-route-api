            "exec": [
              "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
              "pm.test(\"stations loaded\", () => pm.expect(pm.response.json().stations).to.be.above(6000));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/health/",
          "host": [
            "{{baseUrl}}"
