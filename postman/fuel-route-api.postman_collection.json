        {
          "name": "Coordinates and ZIP codes",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "",
                  "pm.test(\"never runs dry, never overfills, fuel adds up leg by leg\", () => {",
                  "    const { mpg, tank_gallons, start_fuel_gallons, end_fuel_gallons } = body.vehicle;",
                  "    let fuel = start_fuel_gallons, mile = 0, detour = 0;",
                  "    for (const stop of body.fuel_stops) {",
                  "        const driven = stop.miles_from_start - mile + detour + stop.off_route_miles;",
                  "        pm.expect(stop.fuel_on_arrival_gallons, `arrival at stop ${stop.number}`).to.be.closeTo(fuel - driven / mpg, 0.03);",
                  "        pm.expect(stop.fuel_on_arrival_gallons, `arrival at stop ${stop.number}`).to.be.at.least(0);",
                  "        fuel = stop.fuel_on_arrival_gallons + stop.gallons_purchased;",
                  "        pm.expect(fuel, `tank after stop ${stop.number}`).to.be.at.most(tank_gallons + 0.01);",
                  "        mile = stop.miles_from_start;",
                  "        detour = stop.off_route_miles;",
                  "    }",
                  "    const driven = body.route.distance_miles - mile + detour;",
                  "    pm.expect(end_fuel_gallons, \"fuel at the finish\").to.be.closeTo(fuel - driven / mpg, 0.03);",
                  "    pm.expect(end_fuel_gallons, \"fuel at the finish\").to.be.at.least(0);",
                  "});",
                  "",
                  "pm.test(\"total cost is the sum of the stops\", () => {",
                  "    const sum = body.fuel_stops.reduce((total, stop) => total + stop.cost, 0);",
                  "    pm.expect(body.summary.total_fuel_cost).to.be.closeTo(sum, 0.05);",
                  "});",
                  "",
                  "pm.test(\"at most one routing call\", () => {",
                  "    pm.expect(body.meta.external_api_calls.routing).to.be.at.most(1);",
                  "});",
                  "",
                  "// Visualize tab: the stops, and the route drawn as an SVG (no map tiles needed).",
                  "const line = body.map.geojson.features.find((f) => f.properties.kind === \"route\").geometry.coordinates;",
                  "const lons = line.map((c) => c[0]), lats = line.map((c) => c[1]);",
                  "const kx = Math.cos(((Math.min(...lats) + Math.max(...lats)) / 2) * Math.PI / 180);",
                  "const minX = Math.min(...lons) * kx, maxX = Math.max(...lons) * kx, minY = Math.min(...lats), maxY = Math.max(...lats);",
                  "const W = 680, pad = 26;",
                  "let scale = (W - 2 * pad) / Math.max(maxX - minX, 1e-6);",
                  "if ((maxY - minY) * scale > 330) scale = 330 / Math.max(maxY - minY, 1e-6);",
                  "const H = Math.round((maxY - minY) * scale + 2 * pad);",
                  "const xy = ([lon, lat]) => [(pad + (lon * kx - minX) * scale).toFixed(1), (pad + (maxY - lat) * scale).toFixed(1)];",
                  "const path = line.map((c, i) => (i ? \"L\" : \"M\") + xy(c).join(\",\")).join(\" \");",
                  "const pin = (lon, lat, color, label) => {",
                  "    const [x, y] = xy([lon, lat]);",
                  "    return `<circle cx=\"${x}\" cy=\"${y}\" r=\"10\" fill=\"${color}\" stroke=\"#fff\" stroke-width=\"2\"/>` +",
                  "        `<text x=\"${x}\" y=\"${y}\" dy=\"3.5\" text-anchor=\"middle\" font-size=\"10\" font-weight=\"700\" fill=\"#fff\">${label}</text>`;",
                  "};",
                  "const pins = [",
                  "    pin(body.start.longitude, body.start.latitude, \"#16a34a\", \"A\"),",
                  "    ...body.fuel_stops.map((s) => pin(s.longitude, s.latitude, \"#f59e0b\", s.number)),",
                  "    pin(body.finish.longitude, body.finish.latitude, \"#dc2626\", \"B\"),",
                  "].join(\"\");",
                  "const rows = body.fuel_stops.map((s) => `<tr><td><span class=\"n\">${s.number}</span></td><td>${s.name}<br><small>${s.city}, ${s.state} · mile ${Math.round(s.miles_from_start).toLocaleString()}</small></td><td>$${s.price_per_gallon.toFixed(3)}</td><td>${s.gallons_purchased.toFixed(1)} gal</td><td>$${s.cost.toFixed(2)}</td></tr>`).join(\"\");",
                  "pm.visualizer.set(`",
                  "<style>",
                  "  body { font: 13px -apple-system, \"Segoe UI\", Roboto, sans-serif; color: #0f172a; margin: 0; }",
                  "  header { padding: 12px 14px 6px; } h3 { margin: 0 0 4px; font-size: 15px; } .muted { color: #64748b; }",
                  "  svg { display: block; margin: 4px 14px; background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; }",
                  "  table { border-collapse: collapse; width: 100%; } td, th { padding: 7px 14px; border-top: 1px solid #e2e8f0; text-align: left; }",
                  "  th { font-size: 11px; text-transform: uppercase; letter-spacing: .04em; color: #64748b; }",
                  "  .n { display: inline-grid; place-items: center; width: 20px; height: 20px; border-radius: 50%; background: #f59e0b; color: #fff; font-weight: 700; font-size: 11px; }",
                  "</style>",
                  "<header>",
                  "  <h3>${body.start.label} → ${body.finish.label}</h3>",
                  "  <div class=\"muted\">${body.route.distance_miles.toLocaleString()} mi · ${body.summary.number_of_stops} stops ·",
                  "  fuel $${body.summary.total_fuel_cost.toFixed(2)} · ${body.meta.external_api_calls.routing} routing call(s)</div>",
                  "</header>",
                  "<svg width=\"${W}\" height=\"${H}\" viewBox=\"0 0 ${W} ${H}\">",
                  "  <path d=\"${path}\" fill=\"none\" stroke=\"#ffffff\" stroke-width=\"7\" stroke-linejoin=\"round\" stroke-linecap=\"round\"/>",
                  "  <path d=\"${path}\" fill=\"none\" stroke=\"#2563eb\" stroke-width=\"3.5\" stroke-linejoin=\"round\" stroke-linecap=\"round\"/>",
                  "  ${pins}",
                  "</svg>",
                  "<table><tr><th>#</th><th>Station</th><th>Price</th><th>Buy</th><th>Cost</th></tr>${rows}</table>",
                  "`);"
                ]
              }
            }
          ],
