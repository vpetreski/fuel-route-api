{
  "info": {
    "_postman_id": "4c496eec-3af0-5552-a92a-712443a8e621",
    "name": "Fuel Route API",
    "description": "Cheapest fuel stops along a US driving route. Start the server (`python manage.py runserver` or `docker compose up`), then send the requests in order. The Visualize tab of a plan shows the route and the stops.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000"
    }
  ],
  "item": [
    {
      "name": "Health",
      "event": [
        {
          "listen": "test",
          "script": {
