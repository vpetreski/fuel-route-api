# Every setting has a working default for local development; override what you need.
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Behind TLS: redirect to HTTPS, secure cookies, HSTS
DJANGO_HTTPS=0

# Vehicle defaults (each request can override them)
VEHICLE_MAX_RANGE_MILES=500
VEHICLE_MPG=10
FUEL_STOP_PENALTY_USD=5
ROUTE_CORRIDOR_MILES=5

# Routing: providers are tried in order, the next one only if the previous is unreachable
ROUTING_PROVIDERS=osrm,valhalla
OSRM_BASE_URL=https://router.project-osrm.org
VALHALLA_BASE_URL=https://valhalla1.openstreetmap.de
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
ROUTE_CACHE_SECONDS=604800
# Requests per client (uncached trips call free public services)
API_RATE_LIMIT=60/minute

# Cache: files under .cache by default; set REDIS_URL to share it across hosts (needs `pip install redis`)
REDIS_URL=
